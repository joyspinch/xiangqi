using System;
using System.IO;

// 设置基座的项目侧断言：
//   - 默认值来自声明；
//   - 越界写入被忽略（基座负责，游戏侧不该崩也不该写坏配置）；
//   - 设置真的落盘（test.ps1 跑两遍：首跑写、次跑读回）。
public class XqSettingsCheck {
    static void Main() {
        XqSettings.Ensure();
        Console.WriteLine("depth=" + Convert.ToString(XqSettings.AiDepth())
            + ",time=" + Convert.ToString(XqSettings.AiTimeMs()));
        XqSettings.SetAiDepth(2);
        XqSettings.SetAiTimeMs(300);
        XqSettings.SetAiDepth(99);   // 越界：必须被忽略，仍是 2
        Console.WriteLine("after=" + Convert.ToString(XqSettings.AiDepth())
            + "," + Convert.ToString(XqSettings.AiTimeMs()));
        Console.WriteLine("settings OK");
    }
}